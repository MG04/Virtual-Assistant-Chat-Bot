# ==============================================================================
# Virtual Personal Assistant - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your credentials:
#   cp .env.example .env
#
# Note: Keep your '.env' file private! It is ignored by git in .gitignore.
# ==============================================================================

# User & Assistant Persona
ASSISTANT_USERNAME=User
ASSISTANT_BOT_NAME=Assistant

# News API Configuration
# Get a free API key from https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here
NEWS_COUNTRY=us

# OpenWeatherMap API Configuration
# Get a free API key from https://openweathermap.org/api
OPENWEATHER_APP_ID=your_openweathermap_api_key_here

# Gmail SMTP Configuration (for sending emails via the assistant)
# 1. Enable 2-Step Verification on your Google account.
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below.
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
